#%RAML 1.0
title: Order Integration Hub API
version: v1
baseUri: http://localhost:8081/api/v1/*
mediaType: application/json

/orders:
  post:
    description: Create a new order
    body:
      application/json:
        example:
          customerId: 1
          items:
            - productId: 2
              quantity: 2
    responses:
      201:
        body:
          application/json:
            example:
              success: true
              orderId: 101
              status: CREATED

  get:
    description: Retrieve all orders
    responses:
      200:
        body:
          application/json:
            example:
              - id: 101
                customerId: 1
                totalAmount: 1598
                status: CREATED
              - id: 102
                customerId: 2
                totalAmount: 499
                status: CREATED

/orders/{id}:
  get:
    description: Retrieve one order by ID
    responses:
      200:
        body:
          application/json:
            example:
              id: 101
              customerId: 1
              totalAmount: 1598
              status: CREATED
              items:
                - productId: 2
                  quantity: 2
                  price: 799

/products:
  get:
    description: Retrieve all products
    responses:
      200:
        body:
          application/json:
            example:
              - id: 1
                name: Laptop Stand
                price: 499
                stock: 20
              - id: 2
                name: Wireless Mouse
                price: 799
                stock: 15
              - id: 3
                name: Keyboard
                price: 1299
                stock: 10